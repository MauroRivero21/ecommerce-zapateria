# URL pública del sitio (sin barra final). En producción usa tu dominio.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Wompi — consola de comercios: https://comercios.wompi.co
# La llave pública se usa en el navegador para el checkout.
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxxx
# Secreto de integridad (servidor). Firma el monto y la referencia.
WOMPI_INTEGRITY_SECRET=prod_integrity_xxxxxxxxxxxxxxxxx
# Secreto de eventos para validar el webhook.
WOMPI_EVENTS_SECRET=prod_events_xxxxxxxxxxxxxxxxx

# Medusa (cuando conectes el catálogo real)
MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_xxxxxxxxxxxxxxxxx
